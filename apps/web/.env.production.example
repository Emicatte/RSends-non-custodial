# ═══════════════════════════════════════════════════════════════════════════
#  RSends Non-Custodial Frontend (Next.js on Vercel) — PRODUCTION/TESTNET env
#
#  Set these in the Vercel dashboard (Project → Settings → Environment Variables).
#  This file is a CHECKLIST — placeholders only, NEVER real secrets.
#
#  NEXT_PUBLIC_*  = compiled into the browser bundle (PUBLIC, never a secret).
#  No prefix      = server-only (Next API routes); safe for secrets.
# ═══════════════════════════════════════════════════════════════════════════

# ── WalletConnect [REQUIRED] — public project id ──
NEXT_PUBLIC_WC_PROJECT_ID=<walletconnect_project_id>

# ── Target chain ── 84532 = Base Sepolia (testnet) ──
NEXT_PUBLIC_TARGET_CHAIN_ID=84532

# ── Backend URL [REQUIRED] ── the Render rsends-api public URL ──
# Server-side route handlers throw at runtime if RPAGOS_BACKEND_URL is unset.
RPAGOS_BACKEND_URL=https://rsends-api.onrender.com
NEXT_PUBLIC_RPAGOS_BACKEND_URL=https://rsends-api.onrender.com
NEXT_PUBLIC_API_URL=https://rsends-api.onrender.com

# ── Internal proxy secret [REQUIRED] ── server-only ──
# MUST EXACTLY MATCH INTERNAL_PROXY_SECRET in the Render backend.
INTERNAL_PROXY_SECRET=<same value as backend INTERNAL_PROXY_SECRET>   # SECRET

# ── HMAC secret [REQUIRED] ── server-only ──
# MUST MATCH HMAC_SECRET in the Render backend (signs /api/tx/callback payloads).
HMAC_SECRET=<same value as backend HMAC_SECRET>                       # SECRET

# ── RSendsRouter address (optional client fallback) ──
# The pay page reads the router from the backend intent response; this is a
# fallback. FILL AFTER the contract deploy (Part 3).
NEXT_PUBLIC_RSENDS_ROUTER_BASE_SEPOLIA=<FILL_AFTER_CONTRACT_DEPLOY>

# ── RPC (optional — falls back to public Base Sepolia RPC) ──
NEXT_PUBLIC_RPC_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>
NEXT_PUBLIC_ALCHEMY_API_KEY=<alchemy_key_if_used_client_side>

# ── CORS allowlist [REQUIRED in prod] ── origins allowed to call /api/* ──
ALLOWED_ORIGINS=https://<your-app>.vercel.app

# ── End-user Auth (NextAuth, credentials only) ──
NEXTAUTH_URL=https://<your-app>.vercel.app
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>                  # SECRET

# ── Admin dashboard — set BEFORE relying on /admin in prod ──
ADMIN_SECRET=<generate: openssl rand -hex 32>                        # SECRET
ADMIN_TOTP_SECRET=                                                   # SECRET (prod: required)

# ── Feature flags ──
NEXT_PUBLIC_FEATURE_CROSSCHAIN=false

# ── Legal issuer data (receipt PDF) ──
NEXT_PUBLIC_COMPANY_NAME=RSend S.r.l.
NEXT_PUBLIC_COMPANY_VAT=IT______________
