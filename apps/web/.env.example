# ═══════════════════════════════════════════════════════════
# Web3 Wallet Connect — Environment Variables
# Copy this file to .env.local and fill in the values.
# ═══════════════════════════════════════════════════════════

# ── WalletConnect ──────────────────────────────────────────
# Get your project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Gasless / Paymaster (Pimlico) — L3 ─────────────────────
# The Pimlico API key is SERVER-ONLY (proxied via /api/paymaster/<network>);
# it must NOT be a NEXT_PUBLIC_ var (would leak into the client bundle).
PIMLICO_API_KEY=
# Public, non-secret flag: "1" tells the client gasless is available.
NEXT_PUBLIC_PAYMASTER_ENABLED=

# ── RPC Endpoints (optional — falls back to public RPCs) ──
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_BNB=
NEXT_PUBLIC_RPC_AVALANCHE=
NEXT_PUBLIC_RPC_CELO=
NEXT_PUBLIC_RPC_BLAST=
NEXT_PUBLIC_RPC_ZKSYNC=
NEXT_PUBLIC_RPC_BASE_SEPOLIA=

# ── Alchemy API Key (optional — for enhanced RPC) ─────────
# Used by both frontend (wagmi transports + gas widget) and backend
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_API_KEY=

# ── Infura API Key (optional — secondary RPC fallback) ────
NEXT_PUBLIC_INFURA_API_KEY=

# ── Default Chain ──────────────────────────────────────────
# 1 = Ethereum, 8453 = Base, 42161 = Arbitrum, 84532 = Base Sepolia
NEXT_PUBLIC_TARGET_CHAIN_ID=8453

# ── Backend API URL (RPagos backend) ──────────────────────
# Server-side URL used by Next.js API routes (not exposed to browser).
# REQUIRED: app/api/* route handlers throw at runtime if this is unset.
# No silent fallback to localhost — set it explicitly in every environment.
RPAGOS_BACKEND_URL=http://localhost:8000
# Public URL (exposed to browser — only for direct client calls, if any)
NEXT_PUBLIC_RPAGOS_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Price feed source for /api/prices (decoupled) ──────────
# The /pay checkout always calls the internal /api/prices route for the EUR
# display estimate. PRICE_SOURCE selects the upstream (server-side, not public):
#   public  → keyless ECB EUR/USD via frankfurter.app (default; no backend needed)
#   backend → proxy {RPAGOS_BACKEND_URL}/api/v1/prices
# On failure the route returns 502 PRICE_SOURCE_UNREACHABLE (never throws).
PRICE_SOURCE=public

# ── Rate limiting (oracle signing — M5) ────────────────────
# Trusted reverse-proxy hops in front of the Next app. getClientIp trusts the
# X-Forwarded-For entry this many positions from the RIGHT (the IP the nearest
# trusted proxy observed), never the client-controlled first hop. On Vercel the
# platform IP (req.ip / x-vercel-forwarded-for) is used automatically; set this
# only for a self-hosted reverse-proxy chain. Default: 1.
RATELIMIT_TRUSTED_PROXY_HOPS=1

# ── RSendsRouter Contract Addresses (NON-CUSTODIAL) ────────
# The payer's wallet calls RSendsRouter.pay()/payNative() directly. The pay page
# primarily reads the router address from the backend payment-intent response
# (intent.onchain.router); these are optional client-side fallbacks per chain.
NEXT_PUBLIC_RSENDS_ROUTER_BASE=
NEXT_PUBLIC_RSENDS_ROUTER_BASE_SEPOLIA=

# ── Internal proxy secret (server-side only) ───────────────
# Authenticates Next server routes to the backend /api/internal/* endpoints (H3).
# Must EXACTLY match INTERNAL_PROXY_SECRET in the backend .env. NOT NEXT_PUBLIC.
INTERNAL_PROXY_SECRET=

# NON-CUSTODIAL: no oracle/compliance signer keys. Transfers are not oracle-gated
# (the payer calls RSendsRouter directly), so ORACLE_SIGNER_MODE / ORACLE_PRIVATE_KEY
# / COMPLIANCE_SIGNER_PRIVATE_KEY have been removed.

# ── HMAC Secret (for webhook verification) ─────────────────
# Server-only. Used by app/api/tx/callback/route.ts (proxy) to sign payloads
# before forwarding to rpagos-backend. NEVER expose with NEXT_PUBLIC_ prefix.
# Must match HMAC_SECRET in rpagos-backend/.env
HMAC_SECRET=

# ── Dati legali emittente (ricevuta PDF) ───────────────────
NEXT_PUBLIC_COMPANY_NAME=RSend S.r.l.
NEXT_PUBLIC_COMPANY_VAT=IT______________
NEXT_PUBLIC_COMPANY_ADDRESS=(sede legale da configurare)
NEXT_PUBLIC_COMPANY_PEC=

# ── Admin Dashboard ────────────────────────────────────────
# Secret token for /admin/* dashboard access (the admin password).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=
# Server-only: the BACKEND's ADMIN_API_TOKEN, used by /api/admin/approvals to
# call the backend's X-Admin-Token admin surface. Never exposed to the client.
BACKEND_ADMIN_API_TOKEN=
# TOTP 2FA (M11). When set, admin login requires a TOTP code (second factor).
# When unset in DEV, login is "bootstrap": password-only, but the session is
# SETUP-ONLY (can only enroll TOTP via /api/admin/2fa/setup, never perform admin
# actions). Enroll, set ADMIN_TOTP_SECRET (base32), then log in with the code.
# ⚠️  FAIL-CLOSED (M11): in PRODUCTION (NODE_ENV=production) an empty value now
#     BLOCKS admin login with HTTP 503 — no bootstrap. Generate the secret
#     out-of-band and set it here BEFORE deploy.
ADMIN_TOTP_SECRET=
# The Bearer ADMIN_SECRET fallback bypasses 2FA, so it is DISABLED in production.
# Set to 1 only if a legacy integration must use Authorization: Bearer <secret>.
ADMIN_ALLOW_BEARER=

# ── CoinGecko Demo API key ─────────────────────────────────
# Get yours free at: https://www.coingecko.com/en/api/pricing
# SERVER-SIDE ONLY. Used by app/api/market/* proxy to inject the
# x-cg-demo-api-key header. Do NOT add a NEXT_PUBLIC_* variant — that
# would leak the key into the client bundle.
COINGECKO_API_KEY=your_key_here

# ── Database (backend) ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── End-user Auth (NextAuth, credentials only) ─────────────
# Public base URL of this Next.js app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── CORS Allowlist ─────────────────────────────────────────
# Comma-separated list of origins allowed to call /api/* (exact match).
# In production: MUST be set; empty value blocks all cross-origin requests.
# In development: falls back to http://localhost:3000 if unset.
# Example for prod: ALLOWED_ORIGINS=https://app.rsends-noncustodial.example
ALLOWED_ORIGINS=https://app.rsends-noncustodial.example

# ── Feature Flags ─────────────────────────────────────────
# Set to "true" only when CCIP cross-chain contract calls are
# fully wired and tested end-to-end. Default false → cross-chain
# UI is hidden and the event monitor is a no-op.
NEXT_PUBLIC_FEATURE_CROSSCHAIN=false
