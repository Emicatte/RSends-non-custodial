# ═══════════════════════════════════════════════════════════════
#  RSends (NON-CUSTODIAL) Backend — Environment Variables
#
#  Copy to .env and fill in values. Placeholders only — NEVER commit real secrets.
#
#  NON-CUSTODIAL: this fork holds NO keys and NO funds. There is intentionally
#  no SWEEP_PRIVATE_KEY, no AWS KMS, no DEPOSIT_MASTER_KEY, no oracle signer,
#  and no treasury config. The payer pays the RSendsRouter contract directly
#  from their own wallet; the indexer watches PaymentMade events.
# ═══════════════════════════════════════════════════════════════

# ── Database [REQUIRED] ─────────────────────────────────────
# Dev:  sqlite+aiosqlite:///./rsend_dev.db
# Prod: postgresql+asyncpg://user:pass@host:5432/rsend
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rsends

# ── Redis [REQUIRED in prod] ────────────────────────────────
# Cache, rate limiting, WebSocket buffer, indexer block checkpoints,
# webhook idempotency (fail-closed).
REDIS_URL=redis://localhost:6379/0

# ── On-chain settlement: RSendsRouter + RPC (NON-CUSTODIAL) ──
# JSON map { chain_id : RSendsRouter address }. Base (8453) first.
# Empty → the PaymentMade indexer stays disabled (e.g. dev).
RSENDS_ROUTER_ADDRESSES_JSON={"8453":"0xYourRSendsRouterOnBase"}
# JSON map { chain_id : RSendsSplitRouter address } (ownerless fee-less N-way
# split). Empty → split intent creation fail-closes 422 SPLIT_UNAVAILABLE.
SPLIT_ROUTER_ADDRESSES_JSON={"8453":"0xYourRSendsSplitRouterOnBase"}
# Optional JSON map { chain_id : RPC URL }. Falls back to rpc_manager defaults.
INDEXER_RPC_URLS_JSON={"8453":"https://mainnet.base.org"}
# Confirmation depth (latest - N) used when the finalized tag is off (fix A)
# or unavailable. 15 on Base (2s blocks) ≈ Paid in ~35s.
INDEXER_CONFIRMATIONS=15
# Widest eth_getLogs range per request; the tick window is scanned in chunks
# of this size. 10 = the Alchemy free-tier cap on Base Sepolia. Raise only if
# EVERY configured provider accepts the wider range.
INDEXER_GETLOGS_MAX_RANGE=10
# Finality mode. true = the chain's finalized tag (L1 finality, ~13 min on
# Base, reorg-proof). false = confirmation-depth mode (fix A): Paid in
# ~INDEXER_CONFIRMATIONS×2s+5s, pre-L1-finality. ROLLBACK of fix A = set this
# back to true (or delete both vars) and restart — nothing else.
INDEXER_USE_FINALIZED_TAG=true
# Block tag treated as final: "finalized" or "safe".
INDEXER_FINALIZED_TAG=finalized
# INERT since B-2 (finalized is terminal — final rows are no longer re-checked).
INDEXER_REORG_SAFETY_DEPTH=64
# Optional JSON map { chain_id : start block } for first-run backfill.
INDEXER_START_BLOCKS_JSON=

# ── Alchemy (RPC; optional but recommended) ─────────────────
# Used by rpc_manager for eth_getLogs / eth_blockNumber. Get one at
# https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here
# Optional: secret for verifying inbound Alchemy webhooks (if used).
ALCHEMY_WEBHOOK_SECRET=
ALCHEMY_AUTH_TOKEN=

# ── Security [REQUIRED in prod] ─────────────────────────────
# GLOBAL HMAC secret for INBOUND frontend callback verification
# (/api/v1/tx/callback) and the tamper-evident audit chain — NOT for outbound
# webhooks and NOT an auth token.
# Outbound merchant webhooks (X-RSend-Signature) are signed with each merchant's
# own per-merchant secret (MerchantWebhook.secret), never this global value.
# Must be >= 32 characters in production.
HMAC_SECRET=change-me-in-production-min-32-chars

# Dedicated admin bearer (X-Admin-Token) gating /api/v1/audit, /admin/aml/*
# and /health/config. Must be >= 32 chars in production and DIFFERENT from
# HMAC_SECRET (startup fails otherwise). Empty = admin surface fully denied.
ADMIN_API_TOKEN=change-me-in-production-min-32-chars

# Shared secret gating /api/internal/* (X-Internal-Secret). Must match the
# Next.js side. [REQUIRED in prod]
INTERNAL_PROXY_SECRET=

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# true for dev (Swagger, verbose logs); MUST be false in production.
DEBUG=false

# ── CORS Origins (prod) ─────────────────────────────────────
# Comma-separated allowed origins. Use YOUR new domain (do NOT reuse rsends.io).
CORS_ORIGINS=https://app.rsends-noncustodial.example

# ── Celery ───────────────────────────────────────────────────
# Used for webhook delivery, intent expiration, email, GDPR deletions.
# (No sweep/matching/fee-recovery tasks in the non-custodial fork.)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── DAC8 Compliance ──────────────────────────────────────────
DAC8_REPORTING_ENTITY_NAME=RSends Noncustodial
DAC8_REPORTING_ENTITY_TIN=
DAC8_REPORTING_COUNTRY=IT
DAC8_FISCAL_YEAR=2026

# ── Anomaly Detection ───────────────────────────────────────
ANOMALY_Z_SCORE_THRESHOLD=3.0
ANOMALY_MIN_SAMPLE_SIZE=10

# ── Notifications (optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=
# Merchant-approval queue messages (KYB submit). Falls back to TELEGRAM_CHAT_ID;
# unset -> notification disabled (warning at boot), the /admin/approvals page
# remains the source of truth.
TELEGRAM_APPROVALS_CHAT_ID=
ALERT_WEBHOOK_URL=
NOTIFICATION_RATE_LIMIT=30
NOTIFICATION_RATE_WINDOW=60

# ── Monitoring (optional) ───────────────────────────────────
SENTRY_DSN=
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=rsends-backend

# ── Trusted Proxies ─────────────────────────────────────────
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── End-user Auth (session JWT) ──────────────────────────────
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'  (>=64 chars in prod)
AUTH_JWT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=security@rsends-noncustodial.example
EMAIL_DEV_MODE=true
APP_URL=
