# ═══════════════════════════════════════════════════════════════
#  RSends (NON-CUSTODIAL) Backend — Environment Variables
#
#  Copy to .env and fill in values. Placeholders only — NEVER commit real secrets.
#
#  NON-CUSTODIAL: this fork holds NO keys and NO funds. There is intentionally
#  no SWEEP_PRIVATE_KEY, no AWS KMS, no DEPOSIT_MASTER_KEY, no oracle signer,
#  and no treasury config. The payer pays the RSendsRouter contract directly
#  from their own wallet; the indexer watches PaymentMade events.
# ═══════════════════════════════════════════════════════════════

# ── Database [REQUIRED] ─────────────────────────────────────
# Dev:  sqlite+aiosqlite:///./rsend_dev.db
# Prod: postgresql+asyncpg://user:pass@host:5432/rsend
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rsends

# ── Redis [REQUIRED in prod] ────────────────────────────────
# Cache, rate limiting, WebSocket buffer, indexer block checkpoints,
# webhook idempotency (fail-closed).
REDIS_URL=redis://localhost:6379/0

# ── On-chain settlement: RSendsRouter + RPC (NON-CUSTODIAL) ──
# JSON map { chain_id : RSendsRouter address }. Base (8453) first.
# Empty → the PaymentMade indexer stays disabled (e.g. dev).
RSENDS_ROUTER_ADDRESSES_JSON={"8453":"0xYourRSendsRouterOnBase"}
# JSON map { chain_id : RSendsRouterV2 address } — the fee-less, OWNERLESS
# router (payer→merchant only; mainnet design). A chain here creates v2
# intents (v2 wins over v1 if both set; the indexer watches both). The
# mainnet cutover is this one env var. Never feed a v2 chain to
# script/SetFeeConfig.s.sol — v2 has no fee config to set.
# RSENDS_ROUTER_V2_ADDRESSES_JSON={"8453":"0xYourRSendsRouterV2OnBase"}
# JSON map { chain_id : RSendsSplitRouter address } (ownerless fee-less N-way
# split). Empty → split intent creation fail-closes 422 SPLIT_UNAVAILABLE.
SPLIT_ROUTER_ADDRESSES_JSON={"8453":"0xYourRSendsSplitRouterOnBase"}
# JSON map { chain NAME : RSendsAutoSplit address } (ownerless fee-less
# keeper-executed split of an incoming balance). Empty → source-wallet
# registration fail-closes 422 AUTO_SPLIT_UNAVAILABLE on every chain.
# Keyed by NAME, not chain id like the three maps above: AutoSplit runs on TRON
# too and TRON has no EVM chain id (giving it one would point a PaymentWatcher
# at a non-EVM node). Names are token_registry.json's: base_sepolia, base,
# ethereum, tron, tron_nile. This map is also the eligibility gate — whatever is
# listed here is what Auto Split is live on.
# NEVER also list this address in any map above: the indexer builds its log
# filters from those chain sets and would fetch every SplitExecuted only to
# discard it. A colliding address is refused outright (see DEPLOY_RUNBOOK 1f).
AUTO_SPLIT_ADDRESSES_JSON={"base_sepolia":"0xYourRSendsAutoSplitOnBaseSepolia","tron_nile":"TYourRSendsAutoSplitOnNile"}
# Optional JSON map { chain_id : [extra RPC providers] } merged into the
# rpc_manager failover list (between Alchemy and the built-in public
# fallbacks). Adding a second paid vendor at mainnet = edit this env only.
# Example:
# RPC_PROVIDERS_JSON={"8453":[{"name":"vendor2","url":"https://base.vendor2.io/v3/KEY"}]}
RPC_PROVIDERS_JSON=
# Confirmation depth (latest - N) used when the finalized tag is off (fix A)
# or unavailable. 15 on Base (2s blocks) ≈ Paid in ~35s.
INDEXER_CONFIRMATIONS=15
# Widest eth_getLogs range per request; the tick window is scanned in chunks
# of this size. 10 = the Alchemy free-tier cap on Base Sepolia. Raise only if
# EVERY configured provider accepts the wider range.
INDEXER_GETLOGS_MAX_RANGE=10
# Finality mode. true = the chain's finalized tag (L1 finality, ~13 min on
# Base, reorg-proof); a tag outage PAUSES finalization loudly (F-10) instead
# of silently paying at depth. false = confirmation-depth mode (fix A): Paid
# in ~INDEXER_CONFIRMATIONS×2s+5s, pre-L1-finality — reorg-SAFE: final rows
# stay reconcilable until true finality, a deeper-than-N reorg fires
# payment.reversed (F-1). ROLLBACK of fix A = set this back to true (or
# delete both vars) and restart — nothing else.
INDEXER_USE_FINALIZED_TAG=true
# Block tag treated as final: "finalized" or "safe". Consulted in BOTH modes
# (depth mode uses it only for the terminal boundary, never the paid gate).
INDEXER_FINALIZED_TAG=finalized
# INERT: superseded by the true-finality terminal boundary (F-1).
INDEXER_REORG_SAFETY_DEPTH=64
# Optional JSON map { chain_id : start block } for first-run backfill.
INDEXER_START_BLOCKS_JSON=

# ── TRON watch-only poller ──────────────────────────────────
# JSON array of TRON HTTP node base URLs, primary first. Watch-only: RSends
# never holds TRON keys and there is no TRON router — the poller only records
# incoming USDT TRC-20 transfers to pending TRON intents' recipients.
# Leave EMPTY to keep the poller off; that is not an error.
# Every node listed here must prove it serves TRON MAINNET at boot (genesis
# block check) or the backend refuses to start — there is no "start with TRON
# disabled" mode, because a node on Nile answers every question plausibly and
# wrongly.
#   TRON_NODE_URLS_JSON=["https://api.trongrid.io","https://<failover-node>"]
TRON_NODE_URLS_JSON=
#
# The same, for the NILE TESTNET. Nodes here are proven against Nile's genesis,
# not mainnet's, so swapping the two variables does not quietly work — it stops
# the boot. That is the entire reason these are two variables instead of one
# with a network flag: with a flag, pointing production at a testnet (or a
# testnet at production) is a one-character edit that nothing catches.
# Intents on this network use chain "tron_nile", are creatable only with a
# test API key, and their settlements are stamped environment=test.
# Nile needs no API key. Test USDT comes from the faucet at https://nileex.io/
#   TRON_NILE_NODE_URLS_JSON=["https://nile.trongrid.io"]
TRON_NILE_NODE_URLS_JSON=
# Optional, and shared by both networks (same provider). Sent as the
# TRON-PRO-API-KEY header; the free tier answers keyless at a lower rate limit
# (~15 QPS). Get one at https://www.trongrid.io/
TRONGRID_API_KEY=

# ── Alchemy (RPC; optional but recommended) ─────────────────
# Used by rpc_manager for eth_getLogs / eth_blockNumber. Get one at
# https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ── Security [REQUIRED in prod] ─────────────────────────────
# GLOBAL HMAC secret for INBOUND frontend callback verification
# (/api/v1/tx/callback) and the tamper-evident audit chain — NOT for outbound
# webhooks and NOT an auth token.
# Outbound merchant webhooks (X-RSend-Signature) are signed with each merchant's
# own per-merchant secret (MerchantWebhook.secret), never this global value.
# Must be >= 32 characters in production.
HMAC_SECRET=change-me-in-production-min-32-chars

# Dedicated admin bearer (X-Admin-Token) gating /api/v1/audit, /admin/aml/*
# and /health/config. Must be >= 32 chars in production and DIFFERENT from
# HMAC_SECRET (startup fails otherwise). Empty = admin surface fully denied.
ADMIN_API_TOKEN=change-me-in-production-min-32-chars

# Shared secret identifying the Next.js proxy hop. Must match the Next.js side
# EXACTLY. [REQUIRED in prod]
#
# The web app presents it as X-RSend-Proxy-Secret alongside X-RSend-Client-IP;
# without a match the backend ignores the claimed address and falls back to the
# socket peer — which is the same value for every request, collapsing every
# per-IP rate limit into one global bucket. A mismatch is therefore silent and
# expensive: the backend logs one warning and keeps serving.
INTERNAL_PROXY_SECRET=

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# true for dev (Swagger, verbose logs); MUST be false in production.
DEBUG=false

# ── CORS Origins (prod) ─────────────────────────────────────
# Comma-separated allowed origins. Use YOUR new domain (do NOT reuse rsends.io).
CORS_ORIGINS=https://app.rsends-noncustodial.example

# ── Celery ───────────────────────────────────────────────────
# Used for webhook delivery, intent expiration, email, GDPR deletions.
# (No sweep/matching/fee-recovery tasks in the non-custodial fork.)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── DAC8 Compliance ──────────────────────────────────────────
DAC8_REPORTING_ENTITY_NAME=RSends Noncustodial
DAC8_REPORTING_ENTITY_TIN=
DAC8_REPORTING_COUNTRY=IT
DAC8_FISCAL_YEAR=2026

# ── Anomaly Detection ───────────────────────────────────────
ANOMALY_Z_SCORE_THRESHOLD=3.0
ANOMALY_MIN_SAMPLE_SIZE=10

# ── Notifications (optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=
# Merchant-approval queue messages (KYB submit). Falls back to TELEGRAM_CHAT_ID;
# unset -> notification disabled (warning at boot), the /admin/approvals page
# remains the source of truth.
TELEGRAM_APPROVALS_CHAT_ID=
ALERT_WEBHOOK_URL=
NOTIFICATION_RATE_LIMIT=30
NOTIFICATION_RATE_WINDOW=60

# ── Monitoring (optional) ───────────────────────────────────
SENTRY_DSN=
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=rsends-backend

# ── Trusted Proxies ─────────────────────────────────────────
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── End-user Auth (session JWT) ──────────────────────────────
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'  (>=64 chars in prod)
AUTH_JWT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=security@rsends-noncustodial.example
EMAIL_DEV_MODE=true
APP_URL=
