# ═══════════════════════════════════════════════════════════════════════════
#  RSends Non-Custodial Backend — PRODUCTION/TESTNET env template
#
#  Copy values into the Render dashboard (envVarGroup "rsends-shared"), NOT into
#  a committed file. This template is a CHECKLIST — placeholders only, NEVER real
#  secrets. SECRET rows must be set in the dashboard and never live in the repo.
#
#  NON-CUSTODIAL: no SWEEP_PRIVATE_KEY, no KMS, no DEPOSIT_MASTER_KEY, no oracle
#  signer. The platform holds no keys and signs nothing on-chain.
#
#  GUARD POSTURE (config.py): is_prod = (not DEBUG) or ENVIRONMENT startswith
#  "prod". For Base Sepolia testnet set ENVIRONMENT=development AND DEBUG=true to
#  relax the prod-only guards (rediss:// TLS, HMAC>=32, AUTH_JWT>=64, OAuth
#  required). For a real mainnet prod deploy: ENVIRONMENT=production, DEBUG=false,
#  rediss:// URLs, and all SECRET rows filled.
# ═══════════════════════════════════════════════════════════════════════════

# ── Posture ──
ENVIRONMENT=development          # testnet; "production" for mainnet
DEBUG=true                       # testnet; MUST be false for mainnet prod

# ── Database [REQUIRED] ── asyncpg driver ONLY (no psycopg2 installed) ──
# Render gives postgresql://…  → you MUST rewrite the scheme to +asyncpg:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/rsends   # SECRET

# ── Redis [REQUIRED] ── testnet redis:// ok; mainnet prod needs rediss:// ──
REDIS_URL=redis://HOST:6379/0                                      # SECRET
CELERY_BROKER_URL=redis://HOST:6379/1                              # SECRET
CELERY_RESULT_BACKEND=redis://HOST:6379/2                          # SECRET

# ── On-chain settlement: RSendsRouter + RPC (NON-CUSTODIAL) ──
# Base Sepolia chainId = 84532. FILL the router AFTER the contract deploy (Part 3).
RSENDS_ROUTER_ADDRESSES_JSON={"84532":"<FILL_AFTER_CONTRACT_DEPLOY>"}
INDEXER_RPC_URLS_JSON={"84532":"https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"}
INDEXER_CONFIRMATIONS=2
INDEXER_USE_FINALIZED_TAG=true
INDEXER_FINALIZED_TAG=finalized
INDEXER_REORG_SAFETY_DEPTH=64
INDEXER_START_BLOCKS_JSON=

# ── Alchemy (RPC) [ALWAYS REQUIRED — startup fails if empty] ──
ALCHEMY_API_KEY=<your_alchemy_api_key>                             # SECRET
ALCHEMY_WEBHOOK_SECRET=
ALCHEMY_AUTH_TOKEN=

# ── Security ──
# Global HMAC for INBOUND /api/v1/tx/callback verification (>=32 chars).
# MUST match HMAC_SECRET on the Vercel frontend.
HMAC_SECRET=<generate: python -c 'import secrets;print(secrets.token_hex(32))'>  # SECRET
# Gates /api/internal/* (X-Internal-Secret). MUST match the frontend value.
INTERNAL_PROXY_SECRET=<generate: openssl rand -hex 32>            # SECRET
# Session JWT signing (>=64 chars in mainnet prod).
AUTH_JWT_SECRET=<generate: python -c 'import secrets;print(secrets.token_hex(32))'>  # SECRET

# ── Server ──
HOST=0.0.0.0
PORT=8000
RUN_MIGRATIONS_ON_BOOT=0         # Render preDeployCommand owns `alembic upgrade head`

# ── CORS ── your Vercel domain(s), comma-separated ──
CORS_ORIGINS=https://<your-app>.vercel.app

# ── End-user Auth (Google OAuth) — optional on testnet ──
GOOGLE_OAUTH_CLIENT_ID=                                           # SECRET (if set)

# ── Email (Resend) — optional on testnet ──
RESEND_API_KEY=                                                  # SECRET (if set)
EMAIL_FROM=security@<your-domain>
EMAIL_DEV_MODE=true
APP_URL=https://<your-app>.vercel.app

# ── Monitoring (optional) ──
SENTRY_DSN=                                                      # SECRET (if set)
OTEL_SERVICE_NAME=rsends-backend

# ── DAC8 ──
DAC8_REPORTING_ENTITY_NAME=RSends Noncustodial
DAC8_REPORTING_COUNTRY=IT
DAC8_FISCAL_YEAR=2026
