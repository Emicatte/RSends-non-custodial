# ═══════════════════════════════════════════════════════════════════════════
#  RSends Non-Custodial Backend — PRODUCTION env template (all guards active)
#
#  Copy values into the Render dashboard (envVarGroup "rsends-shared"), NOT into
#  a committed file. Placeholders only — NEVER real secrets. SECRET rows live in
#  the dashboard, never in the repo.
#
#  POSTURE: ENVIRONMENT=production + DEBUG=false ⇒ EVERY prod guard in config.py
#  is ACTIVE and must be satisfied (see the guard list in DEPLOY_RUNBOOK.md).
#  No security guard is relaxed; only outbound email is toggled off for testnet.
#
#  NON-CUSTODIAL: no SWEEP_PRIVATE_KEY, KMS, DEPOSIT_MASTER_KEY, or oracle signer.
# ═══════════════════════════════════════════════════════════════════════════

# ── Posture ──
ENVIRONMENT=production
DEBUG=false
WALLET_AUTH_ALLOW_LEGACY=false       # guard: replayable legacy sigs forbidden

# ── Database [guard: no default rpagos:password@] ── asyncpg ONLY ──
# Render gives postgresql://… → rewrite scheme to +asyncpg. The SAME URL is used
# by `alembic upgrade head` (async engine) — no separate sync/psycopg2 URL.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/rsends    # SECRET

# ── Redis [guard: MUST be rediss:// TLS in prod] ──
# Use a TLS endpoint. Render Key Value: its TLS connection string. If only
# internal redis:// is available, use an external TLS Redis (Upstash → rediss://).
REDIS_URL=rediss://HOST:6379/0                                      # SECRET
CELERY_BROKER_URL=rediss://HOST:6379/1                              # SECRET
CELERY_RESULT_BACKEND=rediss://HOST:6379/2                          # SECRET

# ── On-chain settlement (Base Sepolia chainId 84532) ──
RSENDS_ROUTER_ADDRESSES_JSON={"84532":"<FILL_AFTER_CONTRACT_DEPLOY>"}
INDEXER_RPC_URLS_JSON={"84532":"https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"}
INDEXER_CONFIRMATIONS=2
INDEXER_USE_FINALIZED_TAG=true
INDEXER_FINALIZED_TAG=finalized
INDEXER_REORG_SAFETY_DEPTH=64
# Cursor lives in Redis (indexer:last_block:{chain_id}); set this ONLY to force a
# backfill start block after a Redis cursor loss: {"84532":"<blockNumber>"}
INDEXER_START_BLOCKS_JSON=

# ── Alchemy [guard: ALWAYS required, prod or not] ──
ALCHEMY_API_KEY=<your_alchemy_api_key>                             # SECRET
ALCHEMY_WEBHOOK_SECRET=

# ── Security guards ──
# HMAC_SECRET >=32 chars; MUST match the Vercel frontend HMAC_SECRET.
HMAC_SECRET=<generate: python -c 'import secrets;print(secrets.token_hex(32))'>  # SECRET
# INTERNAL_PROXY_SECRET non-empty; MUST match the Vercel INTERNAL_PROXY_SECRET.
INTERNAL_PROXY_SECRET=<generate: openssl rand -hex 32>            # SECRET
# AUTH_JWT_SECRET >=64 chars (token_hex(32) = 64).
AUTH_JWT_SECRET=<generate: python -c 'import secrets;print(secrets.token_hex(32))'>  # SECRET
# ADMIN_API_TOKEN >=32 chars, MUST differ from HMAC_SECRET (startup fails on
# empty/short/equal). Gates the admin surface: /api/v1/audit, /admin/aml/*,
# /health/config — header X-Admin-Token.
ADMIN_API_TOKEN=<generate: openssl rand -hex 32>                  # SECRET

# ── End-user auth [guard: GOOGLE_OAUTH_CLIENT_ID required in prod] ──
# Create a Google OAuth client (free; works on a vercel.app domain).
GOOGLE_OAUTH_CLIENT_ID=<google_oauth_client_id>                   # SECRET

# ── Public URL [guard: APP_URL required & non-localhost in prod] ──
APP_URL=https://<your-app>.vercel.app
CORS_ORIGINS=https://<your-app>.vercel.app

# ── Server ──
HOST=0.0.0.0
PORT=8000
RUN_MIGRATIONS_ON_BOOT=0             # Render preDeployCommand owns alembic

# ── Email — testnet convenience: sending OFF (non-security) ──
# APP_URL above is still required. For real mainnet email: EMAIL_DEV_MODE=false
# + RESEND_API_KEY.
EMAIL_DEV_MODE=true
EMAIL_FROM=security@<your-domain>
RESEND_API_KEY=                                                   # SECRET (if EMAIL_DEV_MODE=false)

# ── Monitoring (optional) ──
SENTRY_DSN=                                                       # SECRET (if set)
OTEL_SERVICE_NAME=rsends-backend

# ── DAC8 ──
DAC8_REPORTING_ENTITY_NAME=RSends Noncustodial
DAC8_REPORTING_COUNTRY=IT
DAC8_FISCAL_YEAR=2026
