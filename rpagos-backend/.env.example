# ═══════════════════════════════════════════════════════════════
#  RSend Backend — Environment Variables
#
#  Copy to .env and fill in values.
#  Variables marked [REQUIRED] will cause a startup error if empty.
#  Variables marked [REQUIRED in prod] are only enforced when DEBUG=false.
# ═══════════════════════════════════════════════════════════════

# ── Database [REQUIRED] ─────────────────────────────────────
# Async PostgreSQL connection string.
# Dev:  sqlite+aiosqlite:///./rsend_dev.db
# Prod: postgresql+asyncpg://user:pass@host:5432/rsend
DATABASE_URL=postgresql+asyncpg://rpagos:password@localhost:5432/rpagos

# ── Redis [REQUIRED in prod] ────────────────────────────────
# Used for cache, rate limiting, WebSocket event buffer,
# Celery broker, and NonceManager (atomic nonce allocation).
REDIS_URL=redis://localhost:6379/0

# ── Alchemy [REQUIRED] ──────────────────────────────────────
# API key for RPC calls (eth_gasPrice, eth_sendRawTransaction, etc.)
# ⚠️  Senza questo, NESSUN sweep può essere eseguito!
# Get one at: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Webhook signing secret (from Alchemy Dashboard > Webhooks).
# If empty, backend falls back to block polling (slower, higher RPC usage).
ALCHEMY_WEBHOOK_SECRET=your_webhook_hmac_secret

# Auth token for Alchemy Notify API (manage webhooks programmatically).
ALCHEMY_AUTH_TOKEN=

# ── Sweep Signer [REQUIRED] ─────────────────────────────────
# Private key for the hot wallet that executes sweep transactions.
# Must be a valid 0x-prefixed 64-char hex string (32 bytes).
# ⚠️  Questo wallet DEVE avere ETH per il gas!
# ⚠️  In produzione, usa SIGNER_MODE=kms e KMS_KEY_ID
# WARNING: This key controls funds. Never commit it to git.
SIGNER_MODE=local
SWEEP_PRIVATE_KEY=your_private_key_hex

# AWS KMS key ID (only if SIGNER_MODE=kms). Must be ECC_SECG_P256K1.
# Create with: aws kms create-key --key-spec ECC_SECG_P256K1 --key-usage SIGN_VERIFY
KMS_KEY_ID=
AWS_REGION=eu-west-1

# ── Oracle signer (M1) — DEDICATED key for EIP-712 oracle approvals, separate
# from the sweep hot wallet. Used by /api/internal/oracle/sign-digest when the
# Next oracle runs with ORACLE_SIGNER_MODE=remote.
# ⚠️  In produzione usa ORACLE_SIGNER_MODE=kms + ORACLE_KMS_KEY_ID (key in HSM).
# The resulting signer address MUST be the on-chain oracleSigner (set it via the
# contract before switching the oracle to remote).
ORACLE_SIGNER_MODE=local              # "local" | "kms"
ORACLE_KMS_KEY_ID=                    # dedicated KMS key for the oracle (mode=kms)
ORACLE_SIGNER_PRIVATE_KEY=            # dev/testnet only (mode=local)
# Multisig (M1 slice B) — comma-separated lists for an M-of-N oracle (V5/V6
# threshold). Override the single-key vars above; unset → single signer (N=1).
ORACLE_KMS_KEY_IDS=                   # e.g. key-1,key-2,key-3 (mode=kms)
ORACLE_SIGNER_PRIVATE_KEYS=           # e.g. 0xkey1,0xkey2 (mode=local, dev)

# HashiCorp Vault (only if SIGNER_MODE=vault)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KEY_NAME=rsend-signer

# ── Deposit Address Key [REQUIRED] ──────────────────────────
# Master private key per derivazione deposit addresses.
# Ogni payment intent ottiene un indirizzo unico derivato da questa chiave.
# CRITICO: backup sicuro — se persa, i fondi nei deposit address non sono recuperabili!
# Formato: 0x-prefixed 64-char hex string (32 bytes)
# Generare con: python3 -c "from eth_account import Account; print(Account.create().key.hex())"
DEPOSIT_MASTER_KEY=0x_your_deposit_master_key_here

# ── Security [REQUIRED in prod] ─────────────────────────────
# HMAC secret for webhook signature verification.
# Must be >= 32 characters in production.
HMAC_SECRET=change-me-in-production

# Shared secret for the Next.js oracle → backend /api/internal/* endpoints (H3).
# REQUIRED in prod. Must EXACTLY match INTERNAL_PROXY_SECRET on the Next.js side.
INTERNAL_PROXY_SECRET=

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Set to true for development (enables Swagger UI, hot reload, verbose logs).
# MUST be false in production — controls CORS, docs exposure, and validation strictness.
DEBUG=false

# ── CORS Origins ─────────────────────────────────────────────
# Comma-separated list of allowed origins in production.
# Ignored when DEBUG=true (localhost:3000 and localhost:5173 are auto-allowed).
CORS_ORIGINS=https://rsends.io,https://www.rsends.io

# ── Celery ───────────────────────────────────────────────────
# Broker and result backend for Celery task queue.
# Should be different Redis DBs than REDIS_URL to avoid key collisions.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── DAC8 Compliance ──────────────────────────────────────────
# EU DAC8 crypto-asset reporting entity details.
DAC8_REPORTING_ENTITY_NAME=RSends S.r.l.
DAC8_REPORTING_ENTITY_TIN=IT12345678901
DAC8_REPORTING_COUNTRY=IT
DAC8_FISCAL_YEAR=2025

# ── Reconciliation ──────────────────────────────────────────
# Percentage threshold for treasury mismatch alert (1.0 = 1%).
# Exceeding this opens the circuit breaker and blocks new sweeps.
RECONCILIATION_THRESHOLD_PCT=1.0
# JSON map of chain_id → treasury address for balance reconciliation.
# Example: {"8453":"0xYourBaseTreasury","1":"0xYourEthTreasury"}
TREASURY_ADDRESSES_JSON=

# ── Anomaly Detection ───────────────────────────────────────
# Z-score threshold for flagging anomalous transactions.
ANOMALY_Z_SCORE_THRESHOLD=3.0
ANOMALY_MIN_SAMPLE_SIZE=10

# ── Notifications (opzionale) ───────────────────────────────
# Bot token and chat ID for sweep status alerts.
# Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rate limiting for notification messages (per chat).
NOTIFICATION_RATE_LIMIT=30
NOTIFICATION_RATE_WINDOW=60

# ── Monitoring (opzionale) ──────────────────────────────────
# Sentry DSN for error tracking. Leave empty to disable.
SENTRY_DSN=

# ── OpenTelemetry (opzionale) ──────────────────────────────
# OTLP gRPC endpoint for distributed tracing. Leave empty to disable.
# Example: http://localhost:4317 (Jaeger/Tempo/Grafana Alloy)
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=rsend-backend

# ── Alert Notifications (opzionale) ────────────────────────
# Dedicated Telegram chat for critical alerts (SIGNING_DOWN, KMS_RATE_LIMIT, etc.)
# If empty, falls back to TELEGRAM_CHAT_ID (sweep notifications chat).
# Setup: message @BotFather > /newbot > get token, then @userinfobot for chat_id.
TELEGRAM_ALERT_CHAT_ID=

# Discord or Slack incoming webhook for critical alerts.
# If empty, critical alerts fall back to Telegram.
ALERT_WEBHOOK_URL=

# ── Trusted Proxies (Wave 8.3) ─────────────────────────────
# Headers X-Forwarded-For and X-Real-IP are trusted ONLY when the
# connecting IP matches one of these networks (comma-separated CIDRs).
#
# Dev default: 127.0.0.1 + ::1
#
# Production examples:
#   AWS ALB: use the VPC CIDR (e.g., 10.0.0.0/16)
#   Cloudflare: use the Cloudflare IPv4/IPv6 ranges
#   Direct connection (no proxy): leave as default — forwarded
#     headers will be ignored, which is the safe behavior.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── End-user Auth (Google OAuth + session JWT) ───────────────
# Google OAuth 2.0 "Web application" client ID (e.g. "1234-abc.apps.googleusercontent.com").
# MUST match the `aud` claim in ID tokens issued for our frontend.
# [REQUIRED in production]
GOOGLE_OAUTH_CLIENT_ID=

# HS256 secret for short-lived access tokens. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# [REQUIRED in production — minimum 64 chars]. NEVER commit real values.
AUTH_JWT_SECRET=
